# Copy to .env and fill in. Never commit .env.
#
# None of this is needed for `npm run demo`, which replays committed fixtures
# offline. It is only needed to run the pipeline live against a new subject.

# --- Model provider -----------------------------------------------------------
# Any OpenAI-compatible endpoint. Defaults target OpenRouter's free tier.
# To move to OpenAI or Anthropic later, change the base URL, the key and the
# three model ids. No code changes.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1

# The two verification passes deliberately run on different model families, so
# that a shared blind spot cannot pass as agreement. Changing MODEL_DISCONFIRM to
# match MODEL_CONFIRM silently weakens the verifier.
MODEL_EXTRACT=openai/gpt-oss-20b
MODEL_CONFIRM=openai/gpt-oss-20b
MODEL_DISCONFIRM=qwen/qwen3.8-27b

# --- Search -------------------------------------------------------------------
# Keyless search works from a laptop and is refused from hosted servers, which
# return a challenge page rather than results. A hosted instance needs this.
# Free tier at tavily.com, no card. Leave blank to use DuckDuckGo locally.
TAVILY_API_KEY=

# --- Human gate ---------------------------------------------------------------
# The review server refuses to start without this, so the audit log can never
# record an anonymous approval.
REVIEWER=Tarun Tailor

# --- Budgets ------------------------------------------------------------------
# Exceeding one stops that stage cleanly and leaves the ledger resumable.
# It is not a crash.
MAX_FETCHES=150
MAX_SEARCHES=25
MAX_LLM_CALLS=200

# Client-side pacing. Staying under the provider limit beats retrying after it.
LLM_RPM=4

# --- Offline ------------------------------------------------------------------
# OFFLINE=1 serves only from fixtures. A cache miss throws, naming the key.
# It never falls through to the network.
OFFLINE=0
