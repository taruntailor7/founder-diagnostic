# Pin to the public registry.
#
# Without this, npm picks up whatever registry the machine is configured for.
# A corporate mirror writes its own hostnames into package-lock.json, and the
# committed lockfile then only installs for people inside that network. It
# failed on Render with E401 and would have failed identically for anyone who
# cloned this repo.
registry=https://registry.npmjs.org/
