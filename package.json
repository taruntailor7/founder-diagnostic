{
  "name": "founder-diagnostic",
  "version": "1.0.0",
  "private": true,
  "description": "Researches a person from public sources, verifies every factual claim against a primary source twice, and renders a one-page diagnostic that no unapproved claim can reach.",
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/run.ts",
    "review": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/review.ts",
    "render": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/render.ts",
    "paste": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/paste.ts",
    "demo": "OFFLINE=1 node --experimental-strip-types --disable-warning=ExperimentalWarning bin/run.ts --replay && OFFLINE=1 node --experimental-strip-types --disable-warning=ExperimentalWarning bin/render.ts",
    "lint:doc": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/render.ts --lint-only",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "demo:drift": "node --experimental-strip-types --disable-warning=ExperimentalWarning bin/drift-demo.ts"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  }
}
